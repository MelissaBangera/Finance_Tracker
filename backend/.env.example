PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/finance_tracker
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES=1d
CLIENT_URL=http://localhost:4200

# Set to "false" to skip the OTP step on sign in (signup, forgot and change password always use OTP)
SIGNIN_OTP=true

# SMTP (optional). If SMTP_HOST is empty, OTPs are printed in the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Finance Tracker <no-reply@financetracker.local>"
